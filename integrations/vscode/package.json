{
  "name": "memro-vscode-extension",
  "displayName": "Memro MCP Extension",
  "description": "VS Code extension for Memro MCP integration",
  "version": "0.1.0",
  "publisher": "memro",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/memrohq/memro",
    "directory": "integrations/vscode"
  },
  "icon": "resources/icon-full.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:memro.memoryExplorer",
    "onCommand:memro.remember",
    "onCommand:memro.recall",
    "onCommand:memro.claim",
    "onCommand:memro.logIntent",
    "onCommand:memro.setApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "memro.setApiKey",
        "title": "Memro: Set API Key",
        "category": "Memro"
      },
      {
        "command": "memro.signOut",
        "title": "Memro: Sign Out",
        "category": "Memro"
      },
      {
        "command": "memro.remember",
        "title": "Memro: Remember",
        "category": "Memro"
      },
      {
        "command": "memro.recall",
        "title": "Memro: Recall",
        "category": "Memro"
      },
      {
        "command": "memro.getRecent",
        "title": "Memro: Get Recent Memories",
        "category": "Memro"
      },
      {
        "command": "memro.deleteMemory",
        "title": "Memro: Delete Memory",
        "category": "Memro"
      },
      {
        "command": "memro.exportMemories",
        "title": "Memro: Export Memories",
        "category": "Memro"
      },
      {
        "command": "memro.queryGraph",
        "title": "Memro: Query Knowledge Graph",
        "category": "Memro"
      },
      {
        "command": "memro.claim",
        "title": "\u2b22 Memro: Claim File/Task",
        "category": "Memro"
      },
      {
        "command": "memro.logIntent",
        "title": "\u2b22 Memro: Declare Intent",
        "category": "Memro"
      },
      {
        "command": "memro.release",
        "title": "Memro: Release Resource",
        "category": "Memro"
      },
      {
        "command": "memro.handoff",
        "title": "Memro: Handoff Task (Summarize & Release)",
        "category": "Memro"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memro-explorer",
          "title": "Memro",
          "icon": "resources/icon-monochrome.png"
        }
      ]
    },
    "views": {
      "memro-explorer": [
        {
          "type": "webview",
          "id": "memro.memoryExplorer",
          "name": "Memory Explorer",
          "icon": "resources/icon-monochrome.svg",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "memro.remember",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "memro.remember",
          "group": "memro@1",
          "when": "resourceLangId == plaintext || resourceLangId == markdown || resourceLangId == typescript || resourceLangId == javascript || resourceLangId == python || resourceLangId == java"
        },
        {
          "command": "memro.claim",
          "group": "memro@1"
        }
      ],
      "editor/context": [
        {
          "command": "memro.claim",
          "group": "memro@1"
        },
        {
          "command": "memro.logIntent",
          "group": "memro@1"
        }
      ]
    },
    "configuration": {
      "title": "Memro",
      "properties": {
        "memro.mcpUrl": {
          "type": "string",
          "default": "https://mcp.memro.co/mcp",
          "description": "Memro MCP server (Streamable HTTP). Self-hosted: http://localhost:8080/mcp. The API key is kept in VS Code's secret storage, not in settings."
        },
        "memro.sessionId": {
          "type": "string",
          "default": "default",
          "description": "Coordination session. Claims and intents are only visible to tools in the same session."
        },
        "memro.checkOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "When a file is opened, check whether it is claimed. Sends the file's workspace-relative path to Memro."
        },
        "memro.autoClaimOnEdit": {
          "type": "boolean",
          "default": false,
          "description": "Claim a file automatically when you start editing it. Each claim is stored as a memory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "18.x",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.22.0"
  }
}
