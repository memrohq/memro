# Database (Postgres with the pgvector extension; embeddings live here too)
DATABASE_URL=postgresql://memro:memro@db:5432/memro

# API Server
PORT=8081
LOG_LEVEL=info
BASE_URL=http://localhost:8081
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60
# Read client IPs from X-Forwarded-For. Enable only behind a reverse proxy.
TRUST_PROXY_HEADERS=false
# Accept v1 signatures (timestamp + body). Disabled by default. All modern SDKs
# send X-Signature-Version: 2, which binds method, path, query, and includes
# replay protection. Set to true only if older clients require legacy v1 support.
ALLOW_LEGACY_SIGNATURES=false
MEMORY_SOFT_CAP=1000
# Agent self-registration (ADR 0013): proof-of-work difficulty, whether a
# proof is required, and caps for agents nobody has claimed (0 = no cap).
IDENTITY_POW_BITS=20
IDENTITY_POW_REQUIRED=false
UNCLAIMED_MAX_MEMORIES=0
UNCLAIMED_MAX_FILE_BYTES=0
# Added to the cap message, with {agent_id} replaced.
UNCLAIMED_CAP_HINT=
# Metrics authentication: protects GET /metrics and GET /stats/cache with
# Authorization: Bearer <METRICS_TOKEN>. The "Bearer" scheme prefix is matched
# case-sensitively, as Prometheus sends it. If set, must be at least 32 characters.
# Leave empty for unauthenticated metrics (self-hosting default, logs a warning).
METRICS_TOKEN=

# ── Embedding Provider ────────────────────────────────────────────────────────
# Choose your embedding provider: openai (default) or voyageai
# "anthropic" is accepted as an alias for voyageai.
EMBEDDING_PROVIDER=openai

# OpenAI — used when EMBEDDING_PROVIDER=openai
# Also required for audio transcription (Whisper) regardless of embedding provider
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI — used when EMBEDDING_PROVIDER=voyageai (Anthropic's embedding partner)
# Get your key at https://dash.voyageai.com
# VOYAGE_API_KEY=your_voyage_api_key_here
# ANTHROPIC_API_KEY=  # accepted as fallback for VOYAGE_API_KEY

# Embedding model name (leave blank to use the provider default)
#   OpenAI defaults:  text-embedding-3-small  (1536-dim)
#   Voyage defaults:  voyage-3                (1024-dim)
#
#   Other OpenAI models:   text-embedding-3-large (3072-dim), text-embedding-ada-002 (1536-dim)
#   Other Voyage models:   voyage-3-lite (512-dim), voyage-code-3 (1024-dim)
#
# Changing the model is safe: memories are re-embedded in the background.
EMBEDDING_MODEL=text-embedding-3-small
# Optional: OpenAI-compatible API host (proxy or self-hosted model)
# EMBEDDING_BASE_URL=
# ─────────────────────────────────────────────────────────────────────────────

# File Storage (local disk)
FILE_STORAGE_PATH=./data/files
# Maximum request body, including uploads (bytes)
MAX_BODY_BYTES=10000000

# Email (OTP login). Port 587 uses STARTTLS, 465 uses implicit TLS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_FROM=defaults to EMAIL_HOST_USER

# Local development / staging only: without SMTP, write sign-in codes to the
# server log instead of emailing them. Never enable in production.
DEV_LOG_OTP=false

# Connectors (docs/connectors.md). Each stays off until its settings are set.
# Encrypts provider tokens at rest: openssl rand -base64 32
# CONNECTOR_ENCRYPTION_KEY=
# CONNECTOR_ENCRYPTION_KEY_PREVIOUS=   # old key while rotating
# CONNECTOR_CALLBACK_BASE_URL=         # default: $APP_URL/api
# CONNECTOR_BACKFILL_DAYS=30
# CONNECTOR_SYNC_INTERVAL_MINUTES=30
# CONNECTOR_WORKERS=4
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
# SENTRY_CLIENT_ID=
# SENTRY_CLIENT_SECRET=
# SENTRY_WEBHOOK_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_WEBHOOK_SECRET=

# Optional: Custom domain for production
# DOMAIN=memro.yourdomain.com

# Optional: Enable HTTPS (production)
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
