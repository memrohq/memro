# Database (Postgres with the pgvector extension; embeddings live here too)
DATABASE_URL=postgresql://memro:memro@db:5432/memro

# API Server
PORT=8081
LOG_LEVEL=info
BASE_URL=http://localhost:8081
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60
# Read client IPs from X-Forwarded-For. Enable only behind a reverse proxy.
TRUST_PROXY_HEADERS=false
# Accept v1 signatures (timestamp + body). Turn off once all SDKs send
# X-Signature-Version: 2, which also binds the method, path and query.
ALLOW_LEGACY_SIGNATURES=true
MEMORY_SOFT_CAP=1000

# ── Embedding Provider ────────────────────────────────────────────────────────
# Choose your embedding provider: openai (default) or voyageai
# "anthropic" is accepted as an alias for voyageai.
EMBEDDING_PROVIDER=openai

# OpenAI — used when EMBEDDING_PROVIDER=openai
# Also required for audio transcription (Whisper) regardless of embedding provider
OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI — used when EMBEDDING_PROVIDER=voyageai (Anthropic's embedding partner)
# Get your key at https://dash.voyageai.com
# VOYAGE_API_KEY=your_voyage_api_key_here
# ANTHROPIC_API_KEY=  # accepted as fallback for VOYAGE_API_KEY

# Embedding model name (leave blank to use the provider default)
#   OpenAI defaults:  text-embedding-3-small  (1536-dim)
#   Voyage defaults:  voyage-3                (1024-dim)
#
#   Other OpenAI models:   text-embedding-3-large (3072-dim), text-embedding-ada-002 (1536-dim)
#   Other Voyage models:   voyage-3-lite (512-dim), voyage-code-3 (1024-dim)
#
# Changing the model is safe: memories are re-embedded in the background.
EMBEDDING_MODEL=text-embedding-3-small
# Optional: OpenAI-compatible API host (proxy or self-hosted model)
# EMBEDDING_BASE_URL=
# ─────────────────────────────────────────────────────────────────────────────

# File Storage (local disk)
FILE_STORAGE_PATH=./data/files
# Maximum request body, including uploads (bytes)
MAX_BODY_BYTES=10000000

# Email (OTP login). Port 587 uses STARTTLS, 465 uses implicit TLS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_FROM=defaults to EMAIL_HOST_USER

# Optional: Custom domain for production
# DOMAIN=memro.yourdomain.com

# Optional: Enable HTTPS (production)
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
